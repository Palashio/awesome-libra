    "    'petal length (cm)': [1.4, 4.5, 6.3],
    "    'petal width (cm)': [0.2, 1.5, 1.8]
    "})
    "
    "sample_iris_data.to_csv('sample_iris.csv', index=False)
    "predictions_iris = iris_client.predict('sample_iris.csv')
    "print(f\"Predicted species: {predictions_iris}\")
    "
    "print(\"\
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Example 5: Advanced Features - Model Comparison
    "
    "Libra can automatically compare multiple algorithms and select the best one."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a dataset for model comparison
    "X_comp, y_comp = make_classification(
    "    n_samples=1500, 
    "    n_features=15, 
    "    n_informative=10, 
    "    n_classes=2, 
    "    random_state=42
    ")
    "
    "comp_df = pd.DataFrame(X_comp, columns=[f'feature_{i+1}' for i in range(15)])
    "comp_df['target'] = y_comp
    "comp_df.to_csv('comparison_data.csv', index=False)
    "
    "print(\"🏆 Model Comparison with Libra\")
    "print(\"=\" * 40)
    "
    "# 🎯 ONE LINE OF CODE: Compare multiple models automatically!
    "comp_client = client('comparison_data.csv')
    "comp_client.classification(target='target', test_size=0.2, random_state=42)
    "
    "print(\"\
    "print(\"📊 Libra automatically tested multiple algorithms and selected the best performer!\")"
   ]
  },
  {
   "cell_type": "markdown",

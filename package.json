    "interactive",
    "coding",
    "education",
    "learning"
  ],
  "author": "TypeScript Tutorial",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.10.0",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "@types/readline-sync": "^1.4.8"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}


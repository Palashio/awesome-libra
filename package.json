{
  "name": "typescript-interactive-tutorial",
  "version": "1.0.0",
  "description": "An interactive TypeScript coding tutorial with hands-on exercises and lessons",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "typescript",

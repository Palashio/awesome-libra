    "## Demo 3: Neural Networks with Libra\n",
    "\n",
    "Let's create a more complex dataset and show how Libra handles neural networks.\n",
    "\n",
    "### Step 1: Create Complex Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a complex non-linear dataset\n",
    "np.random.seed(42)\n",
    "n_samples = 2000\n",
    "\n",
    "# Generate features with non-linear relationships\n",
    "X1 = np.random.uniform(-3, 3, n_samples)\n",
    "X2 = np.random.uniform(-3, 3, n_samples)\n",
    "X3 = np.random.uniform(-2, 2, n_samples)\n",
    "\n",
    "# Create non-linear target\n",
    "y = (np.sin(X1) * np.cos(X2) + X3**2 + \n",
    "     0.5 * X1 * X2 + np.random.normal(0, 0.1, n_samples))\n",
    "\n",
    "# Create DataFrame\n",
    "neural_data = pd.DataFrame({\n",
    "    'feature_1': X1,\n",
    "    'feature_2': X2,\n",
    "    'feature_3': X3,\n",
    "    'target': y\n",
    "})\n",
    "\n",
    "print(\"Complex Neural Network Dataset Created!\")\n",
    "print(f\"Shape: {neural_data.shape}\")\n",
    "neural_data.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [

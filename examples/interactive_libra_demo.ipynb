   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Import Libraries\n",
    "\n",
    "Let's import the necessary libraries for our demo:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.datasets import make_regression, make_classification, load_iris\n",
    "from sklearn.model_selection import train_test_split\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Import Libra\n",
    "try:\n",
    "    from libra import client\n",
    "    print(\"✅ Libra imported successfully!\")\n",
    "except ImportError:\n",
    "    print(\"❌ Libra not found. Please install it using: pip install libra\")\n",
    "    print(\"For this demo, we'll simulate Libra's functionality.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Demo 1: Regression with Libra\n",
    "\n",
    "Let's start with a regression problem. We'll predict house prices based on various features.\n",
    "\n",
    "### Step 1: Create Sample Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a synthetic housing dataset\n",
    "np.random.seed(42)\n",
    "n_samples = 1000\n",
    "\n",
    "# Generate features\n",
    "square_feet = np.random.normal(2000, 500, n_samples)\n",
    "bedrooms = np.random.randint(1, 6, n_samples)\n",
    "bathrooms = np.random.randint(1, 4, n_samples)\n",
    "age = np.random.randint(0, 50, n_samples)\n",
    "location_score = np.random.uniform(1, 10, n_samples)\n",
    "\n",
    "# Generate target (house prices) with some realistic relationships\n",
    "price = (square_feet * 150 + \n",
    "         bedrooms * 10000 + \n",
    "         bathrooms * 15000 + \n",
    "         location_score * 20000 - \n",
    "         age * 1000 + \n",
    "         np.random.normal(0, 50000, n_samples))\n",
    "\n",
    "# Create DataFrame\n",
    "housing_data = pd.DataFrame({\n",
    "    'square_feet': square_feet,\n",
    "    'bedrooms': bedrooms,\n",
    "    'bathrooms': bathrooms,\n",
    "    'age': age,\n",
    "    'location_score': location_score,\n",
    "    'price': price\n",
    "})\n",
    "\n",
    "print(\"Housing Dataset Created!\")\n",
    "print(f\"Shape: {housing_data.shape}\")\n",
    "housing_data.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Explore the Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic statistics\n",
    "print(\"Dataset Statistics:\")\n",
    "print(housing_data.describe())\n",
    "\n",
    "# Visualize relationships\n",
    "plt.figure(figsize=(15, 10))\n",
    "\n",
    "# Price distribution\n",
    "plt.subplot(2, 3, 1)\n",
    "plt.hist(housing_data['price'], bins=30, alpha=0.7)\n",
    "plt.title('Price Distribution')\n",
    "plt.xlabel('Price ($)')\n",
    "\n",
    "# Price vs Square Feet\n",
    "plt.subplot(2, 3, 2)\n",
    "plt.scatter(housing_data['square_feet'], housing_data['price'], alpha=0.5)\n",
    "plt.title('Price vs Square Feet')\n",
    "plt.xlabel('Square Feet')\n",
    "plt.ylabel('Price ($)')\n",
    "\n",
    "# Price vs Location Score\n",
    "plt.subplot(2, 3, 3)\n",
    "plt.scatter(housing_data['location_score'], housing_data['price'], alpha=0.5)\n",
    "plt.title('Price vs Location Score')\n",
    "plt.xlabel('Location Score')\n",
    "plt.ylabel('Price ($)')\n",
    "\n",
    "# Correlation heatmap\n",
    "plt.subplot(2, 3, 4)\n",
    "correlation_matrix = housing_data.corr()\n",
    "sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', center=0)\n",
    "plt.title('Feature Correlations')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Save Data and Use Libra for Regression\n",
    "\n",
    "Now comes the magic of Libra - machine learning in one line!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save the dataset\n",

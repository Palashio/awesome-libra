    "plt.xlabel('Feature 1')\n",
    "plt.ylabel('Target')\n",
    "plt.title('Non-linear Relationship: Feature 1 vs Target')\n",
    "\n",
    "plt.subplot(1, 3, 2)\n",
    "plt.scatter(neural_data['feature_2'], neural_data['target'], alpha=0.5)\n",

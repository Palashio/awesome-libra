    "plt.title('Non-linear Relationship: Feature 2 vs Target')\n",
    "\n",
    "plt.subplot(1, 3, 3)\n",
    "plt.scatter(neural_data['feature_3'], neural_data['target'], alpha=0.5)\n",
    "plt.xlabel('Feature 3')\n",
    "plt.ylabel('Target')\n",
    "plt.title('Non-linear Relationship: Feature 3 vs Target')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
